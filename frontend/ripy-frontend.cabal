cabal-version: 2.4
name: ripy-frontend
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Ducking, MediaManagement, Protocol, Model, Selection, VoiceProtocol
  hs-source-dirs: src
  build-depends: base >=4.12 && <5, aeson, bytestring, text
  default-language: Haskell2010
  ghc-options: -Wall

executable ripy-frontend
  main-is: Main.hs
  hs-source-dirs: app
  other-modules: Bindings, Catalog, Connection, MediaBindings, MediaManagementView,
                 MediaTransfer, MovieView, Network, Player, View, Voice, VoiceBindings,
                 VoiceView
  build-depends: base >=4.12 && <5, ripy-frontend, reflex-dom, reflex,
                text, bytestring, aeson, containers, ghcjs-base, transformers
  if !impl(ghcjs)
    buildable: False
  default-language: Haskell2010
  ghc-options: -Wall

test-suite model-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends: base, ripy-frontend, aeson, bytestring, text
  default-language: Haskell2010

executable protocol-check
  main-is: Compatibility.hs
  hs-source-dirs: test
  build-depends: base, ripy-frontend, aeson, bytestring, text
  if impl(ghcjs)
    buildable: False
  default-language: Haskell2010
